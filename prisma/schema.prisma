enum CupomTipo {
  PERCENTUAL
  VALOR
}

model Cupom {
  id          String    @id @default(cuid())
  /// Código digitado no checkout — sempre salvo em MAIÚSCULAS
  codigo      String    @unique
  tipo        CupomTipo
  /// Valor do desconto: % quando PERCENTUAL, R$ quando VALOR
  valor       Decimal   @db.Decimal(10, 2)
  /// Subtotal mínimo para o cupom valer (null = sem mínimo)
  minSubtotal Decimal?  @db.Decimal(10, 2)
  /// Data limite de uso (null = sem validade)
  validadeAte DateTime?
  /// Máximo de usos (null = ilimitado)
  usoMaximo   Int?
  usados      Int       @default(0)
  ativo       Boolean   @default(true)
  descricao   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ============================================================
// MÓDULO MOTOS — peças compatíveis por moto e faixa de ano
// ============================================================

model Moto {
  id                String   @id @default(cuid())
  marca             String
  modelo            String
  /// Ano inicial da faixa (ex.: GS 1200 2013–2018 → anoDe=2013)
  anoDe             Int
  /// Ano final; null = "em diante"
  anoAte            Int?
  slug              String   @unique
  /// Medida de fábrica do pneu dianteiro (ex.: "120/70-19")
  medidaDianteira   String?
  /// Medida de fábrica do pneu traseiro (ex.: "170/60-17")
  medidaTraseira    String?
  /// Só medidas conferidas pela loja aparecem na busca por placa — o
  /// pré-preenchimento entra como false para o Caio validar no admin
  medidasConferidas Boolean  @default(false)
  /// De onde veio a medida: "pneus.org", "curadoria", "loja"
  fonteMedidas      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  produtos ProdutoMoto[]

  @@unique([marca, modelo, anoDe, anoAte])
  @@index([marca, modelo])
}

model ProdutoMoto {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  motoId    String
  moto      Moto    @relation(fields: [motoId], references: [id], onDelete: Cascade)

  @@unique([productId, motoId])
  @@index([motoId])
  @@index([productId])
}

