generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  // PostgreSQL próprio na VPS (container "db"). Conexão direta, sem pooler —
  // por isso não há directUrl separado (isso era exigência do antigo Neon).
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String        @id @default(cuid())
  nome          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  senha         String?
  telefone      String?
  cpf           String?
  role          Role          @default(CUSTOMER)
  /// Áreas do painel liberadas para este usuário (chaves de lib/admin/permissoes.ts).
  /// Vazio = usa o padrão do papel. ADMIN enxerga tudo, ignorando esta lista.
  permissoes    Json          @default("[]")
  /// Desligado bloqueia o login sem apagar histórico do usuário.
  ativo         Boolean       @default(true)
  /// Origem do cadastro do cliente
  origem        OrigemCliente @default(ECOMMERCE)
  /// ID do cliente no Tiny ERP (quando importado do ML)
  tinyClienteId String?
  createdAt     DateTime      @default(now())

  accounts     Account[]
  sessions     Session[]
  orders       Order[]
  appointments Appointment[]
  crm          CustomerCRM?
  reviews      Review[]
}

enum Role {
  CUSTOMER
  ADMIN
  /// Acesso restrito ao painel — por padrão só as imagens do site.
  /// O que cada um enxerga vem de User.permissoes; ver lib/admin/permissoes.ts
  MARKETING
}

/// Origem do cliente para separar e-commerce próprio de Mercado Livre
enum OrigemCliente {
  ECOMMERCE // Comprou direto no nosso site
  MERCADOLIVRE // Cliente do ML importado do Tiny
  AGENDAMENTO // Entrou via agendamento de serviço
  MANUAL // Cadastrado manualmente pelo admin
}

model Product {
  id                    String         @id @default(cuid())
  sku                   String         @unique
  nome                  String
  slug                  String         @unique
  descricao             String         @db.Text
  preco                 Decimal        @db.Decimal(10, 2)
  precoPromocional      Decimal?       @db.Decimal(10, 2)
  estoque               Int            @default(0)
  categoria             String
  marca                 String
  compatibilidadeMotos  Json           @default("[]")
  imagens               Json           @default("[]")
  ativo                 Boolean        @default(true)
  destaque              Boolean        @default(false)
  /// Pré-venda: pode ser comprado mesmo com estoque 0 (ex.: produtos Pirelli do evento de Sorocaba)
  preVenda              Boolean        @default(false)
  /// Prazo de postagem prometido na pré-venda, em dias úteis (exibido no card/página)
  prazoEntregaDias      Int?
  /// Campanha Pirelli à qual este produto de pré-venda pertence.
  /// Null identifica o catálogo regular do e-commerce.
  eventoPirelliId       String?
  eventoPirelli         EventoPirelli? @relation(fields: [eventoPirelliId], references: [id], onDelete: Restrict)
  /// Ordena a vitrine exclusiva da landing page do evento.
  ordemEvento           Int            @default(0)
  /// Limite comercial por pedido. A pré-venda não usa estoque físico.
  limitePorPedidoEvento Int?
  /// ID do produto no Tiny ERP
  tinyId                String?
  /// Marca true após verificar imagens no Tiny (mesmo que não tenha nenhuma)
  imagensVerificadas    Boolean        @default(false)
  /// True quando o produto tem pelo menos 1 imagem — usado para filtrar exibição
  temImagem             Boolean        @default(false)
  /// SKU do produto-pai quando este é uma variação de tamanho (filho some das listagens)
  variacaoDe            String?
  /// True para produto-pai de variações (_PAI do Tiny) — card vira "escolher tamanho"
  ehPai                 Boolean        @default(false)
  /// Depósito de origem no Olist: loja | f_drop | eurolaqui | outro (populado pelo worker)
  fornecedor            String?
  /// Admin marcou p/ MANTER na loja mesmo sendo de fornecedor bloqueado (Eurolaqui)
  mantidoManual         Boolean        @default(false)
  /// Admin OCULTOU manualmente da loja (mesmo ativo no Olist) — sync respeita
  ocultoManual          Boolean        @default(false)
  /// Peso em kg (para cotação de frete)
  peso                  Decimal?       @db.Decimal(8, 3)
  /// Altura em cm
  altura                Decimal?       @db.Decimal(8, 2)
  /// Largura em cm
  largura               Decimal?       @db.Decimal(8, 2)
  /// Comprimento em cm
  comprimento           Decimal?       @db.Decimal(8, 2)
  /// Medida do pneu decomposta a partir do nome — o Olist mistura as grafias
  /// ("150/60-17", "150/60 R17", "150/60ZR17"), então a busca usa estes 3
  /// inteiros em vez de texto. Null = produto não é pneu. Ver lib/medida-pneu.ts
  medidaLargura         Int?
  medidaPerfil          Int?
  medidaAro             Int?
  /// Construção do pneu: "radial" (150/70R17) ou "diagonal" (150/70-17).
  /// Não é estilo de escrita — são pneus diferentes e não intercambiáveis.
  medidaConstrucao      String?
  /// Segmento de uso do pneu (Custom, Big Trail, Esportivo/Street, Scooter).
  /// Classificação comercial da loja: o Olist só manda "Pneu >> <marca>", então
  /// o sync NUNCA escreve neste campo — quem define é o admin.
  pneuSegmentoId        String?
  pneuSegmento          PneuSegmento?  @relation(fields: [pneuSegmentoId], references: [id], onDelete: SetNull)
  /// Linha/modelo do pneu dentro do segmento (ex.: "Angel GT", "Sportmax").
  /// Vira subcategoria em /pneus/<segmento>. Também definida pelo admin.
  pneuLinha             String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  orderItems OrderItem[]
  reviews    Review[]
  motos      ProdutoMoto[]
  reservas   ReservaEstoque[]

  // Reintroduzidos por introspecção: existiam no banco e não no schema
  estoqueReservado Int @default(0)

  @@index([variacaoDe])
  @@index([pneuSegmentoId, ativo])
  @@index([medidaLargura, medidaPerfil, medidaAro])
  @@index([estoqueReservado])
  @@index([eventoPirelliId, ativo, ordemEvento])
}

/// Segmentos de pneu da vitrine (Custom, Big Trail, Esportivo/Street, Scooter).
/// Ficam em tabela, e não no código, porque a loja precisa criar e renomear
/// segmento sem depender de deploy.
model PneuSegmento {
  id        String   @id @default(cuid())
  nome      String   @unique
  slug      String   @unique
  /// Texto curto exibido no card da categoria
  descricao String?
  /// Imagem do card — null usa a arte padrão da vitrine
  imagemUrl String?
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produtos Product[]

  @@index([ativo, ordem])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Nome exibido (pode ser anônimo)
  nome      String
  nota      Int // 1–5
  titulo    String?
  corpo     String   @db.Text
  /// Moderação: só exibe se true
  aprovado  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([aprovado])
}

model Order {
  id                        String                     @id @default(cuid())
  orderNumber               String                     @unique
  userId                    String?
  user                      User?                      @relation(fields: [userId], references: [id])
  status                    OrderStatus                @default(AGUARDANDO_PAGAMENTO)
  subtotal                  Decimal                    @db.Decimal(10, 2)
  frete                     Decimal                    @db.Decimal(10, 2)
  desconto                  Decimal                    @default(0) @db.Decimal(10, 2)
  /// Código do cupom aplicado; `desconto` guarda cupom + eventual desconto à vista.
  cupomCodigo               String?
  total                     Decimal                    @db.Decimal(10, 2)
  enderecoEntrega           Json
  /// Modalidade escolhida antes do redirecionamento; protege descontos condicionais.
  meioPagamentoCheckout     MeioPagamentoCheckout?
  pagamentoMetodo           String?
  pagamentoIdExterno        String?
  olistOrderId              String?
  /// Lease local que impede duas chamadas concorrentes de criarem o mesmo pedido no Olist.
  olistSyncStatus           String?
  olistSyncExpiraEm         DateTime?
  /// Serviço de frete escolhido pelo cliente (ex: "pac", "sedex", "jadlog", "jet")
  freteServico              String?
  /// Nome da transportadora exibido ao cliente (ex: "Correios PAC", "Jadlog Package")
  freteTransportadora       String?
  /// Prazo estimado em dias úteis informado na cotação
  fretePrazo                Int?
  /// Código de rastreamento informado pela transportadora (preenchido após envio)
  trackingCode              String?
  /// Chave fiscal importada da NF-e autorizada na Olist (com fallback manual).
  /// O envio comercial não pode ser preparado no Melhor Envio sem ela.
  nfeChave                  String?                    @unique
  nfeRegistradaEm           DateTime?
  /// ID do envio no carrinho do Melhor Envio. Criado automaticamente depois
  /// da NF-e autorizada — ainda SEM comprar etiqueta (não gasta saldo).
  melhorEnvioId             String?
  /// Etapa do envio no ME: CARRINHO → COMPRA_INCERTA | COMPRADA → GERADA | CANCELADA. Null = não usa ME
  /// (retirada na loja, ou pedido anterior à integração).
  melhorEnvioStatus         String?
  /// Lease local para preparar/comprar uma etiqueta uma única vez.
  melhorEnvioSyncStatus     String?
  melhorEnvioSyncExpiraEm   DateTime?
  /// URL do PDF da etiqueta, preenchida depois da compra pelo admin
  melhorEnvioEtiqueta       String?
  /// Canal de origem do pedido
  canal                     CanalVenda                 @default(ECOMMERCE)
  /// Campanha de origem, derivada no servidor a partir dos produtos.
  eventoPirelliId           String?
  eventoPirelli             EventoPirelli?             @relation(fields: [eventoPirelliId], references: [id], onDelete: Restrict)
  /// Participante identificado por um token opaco na jornada do evento. Permite liberar
  /// brindes automaticamente depois que o Mercado Pago confirma o pedido.
  eventoPirelliVisitanteId  String?
  eventoPirelliVisitante    EventoPirelliVisitante?    @relation(fields: [eventoPirelliVisitanteId], references: [id], onDelete: Restrict)
  compraCanecaEventoPirelli EventoPirelliCompraCaneca?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  items    OrderItem[]
  tracking OrderTracking[]

  // Reintroduzidos por introspecção: existiam no banco e não no schema
  checkoutTentativaId       String?              @unique
  pagamentoResultadoIncerto Boolean              @default(false)
  cupomConsumido            Boolean              @default(false)
  reservaExpiraEm           DateTime?
  reservaLiberadaEm         DateTime?
  /// Momento em que as obrigações duráveis de e-mail/WhatsApp da compra
  /// foram gravadas. Null em pedido pago exige reparo pela reconciliação.
  notificacoesAgendadasEm   DateTime?
  PagamentoTentativa        PagamentoTentativa[]
  ReembolsoPagamento        ReembolsoPagamento[]

  @@index([status, reservaExpiraEm])
  @@index([olistSyncStatus, olistSyncExpiraEm])
  @@index([melhorEnvioSyncStatus, melhorEnvioSyncExpiraEm])
  @@index([eventoPirelliId, status, createdAt])
  @@index([eventoPirelliVisitanteId, status, createdAt])
}

enum CanalVenda {
  ECOMMERCE
  MERCADOLIVRE
  EVENTO_PIRELLI
}

enum MeioPagamentoCheckout {
  PIX
  BOLETO
  CARTAO
}

enum OrderStatus {
  AGUARDANDO_PAGAMENTO
  CONFIRMADO
  SEPARANDO
  ENVIADO
  ENTREGUE
  CANCELADO
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id])
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2)

  // Reintroduzidos por introspecção: existiam no banco e não no schema
  estoqueReservado         Boolean @default(true)
  /// Snapshots: editar o produto depois da compra não muda a promessa feita.
  preVendaSnapshot         Boolean @default(false)
  prazoEntregaDiasSnapshot Int?

  @@index([orderId])
  @@index([productId])
}

model OrderTracking {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  status    String
  descricao String
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model CustomerCRM {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id])
  /// Categoria principal do relacionamento com este cliente
  categoria     CRMCategoria @default(VENDA_ECOMMERCE)
  totalPedidos  Int          @default(0)
  totalGasto    Decimal      @default(0) @db.Decimal(10, 2)
  totalServicos Int          @default(0) // agendamentos realizados
  ultimaCompra  DateTime?
  ultimoServico DateTime?
  notas         String?      @db.Text
  etapaFunil    Funil        @default(LEAD)
  updatedAt     DateTime     @updatedAt
}

/// Categorias do CRM
enum CRMCategoria {
  VENDA_ECOMMERCE // Clientes que compraram no nosso site
  VENDA_ML // Clientes do Mercado Livre
  SERVICO // Clientes que agendaram serviços (box rápido)
  MISTO // Comprou E agendou serviço
}

enum Funil {
  LEAD
  ORCAMENTO
  FECHADO
  RECORRENTE
}

model Appointment {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  nome             String
  telefone         String
  servico          String
  motoModelo       String
  dataPreferida    DateTime
  horarioPreferido String
  status           String   @default("pendente")
  notas            String?  @db.Text
  /// Valor cobrado pelo serviço (opcional, preenchido após conclusão)
  valorServico     Decimal? @db.Decimal(10, 2)
  createdAt        DateTime @default(now())

  reservas ReservaEstoque[]
}

// ============================================================
// MÓDULO CRM INTELIGENTE — Evolution API + WhatsApp
// ============================================================

/// Lead capturado via pop-up, botão WhatsApp, agendamento ou checkout
model CrmLead {
  id          String     @id @default(cuid())
  nome        String
  whatsapp    String     @unique // o banco já tem esse índice único
  /// Origem da captura
  origem      LeadOrigem @default(POPUP)
  /// Produto que estava visualizando (opcional)
  produtoSlug String?
  /// Etapa atual no funil
  etapa       LeadEtapa  @default(NOVO)
  /// UTM para rastrear campanha
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  /// Notas internas
  notas       String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  mensagens CrmMensagem[]

  // Reintroduzidos por introspecção: existiam no banco e não no schema
  consentimentoMarketingEm DateTime?
  /// Supressão global de automações WhatsApp após PARE/SAIR.
  whatsappOptOutEm         DateTime?

  @@index([whatsapp])
  @@index([etapa, createdAt])
}

enum LeadOrigem {
  POPUP // Pop-up de captura no site
  WHATSAPP_BTN // Clicou no botão WhatsApp de um produto
  AGENDAMENTO // Preencheu formulário de agendamento
  CHECKOUT // Abandonou o carrinho
  MANUAL // Adicionado manualmente pelo admin
  EVENTO_PIRELLI // Evento presencial Pirelli
}

enum LeadEtapa {
  NOVO // Acabou de ser capturado
  CONTATADO // Mensagem enviada
  RESPONDEU // Cliente respondeu no WhatsApp
  CONVERTIDO // Realizou uma compra ou agendamento
  PERDIDO // Sem resposta / desinteressado
}

/// Fila de mensagens WhatsApp via Evolution API
model CrmMensagem {
  id                String         @id @default(cuid())
  /// Chave funcional opcional. Mensagens transacionais sempre a usam para
  /// impedir duplicidade entre webhook, retorno e cron.
  chaveIdempotencia String?        @unique
  /// Lead relacionado (opcional — mensagens de pedido têm userId)
  leadId            String?
  lead              CrmLead?       @relation(fields: [leadId], references: [id])
  /// Usuário relacionado (opcional)
  userId            String?
  /// Número WhatsApp destino (com DDI, ex: 5519999999999)
  whatsapp          String
  nome              String
  /// Tipo da mensagem para saber qual template usar
  tipo              MensagemTipo
  /// Conteúdo final da mensagem (já com variáveis substituídas)
  conteudo          String         @db.Text
  /// Status do envio
  status            MensagemStatus @default(PENDENTE)
  /// Payload com dados extras (número pedido, rastreio, etc.)
  payload           Json           @default("{}")
  /// ID retornado pela Evolution API
  evolutionId       String?
  /// Quantidade de tentativas de envio
  tentativas        Int            @default(0)
  /// Erro da última tentativa
  erro              String?        @db.Text
  /// Quando enviar (suporte a envio agendado)
  agendadoPara      DateTime       @default(now())
  /// Lease curta: se o worker cair, outro worker retoma a linha.
  leaseExpiraEm     DateTime?
  /// Quando foi efetivamente enviada
  enviadaEm         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, agendadoPara])
  @@index([status, leaseExpiraEm])
  @@index([whatsapp])
  @@index([createdAt])
}

enum MensagemTipo {
  BOAS_VINDAS // Lead capturado
  AGENDAMENTO // Agendamento confirmado
  PEDIDO_CONFIRMADO // Pagamento aprovado
  PEDIDO_ENVIADO // Código de rastreio disponível
  PEDIDO_ENTREGUE // Entrega confirmada pela transportadora
  CARRINHO_ABANDONADO // Carrinho abandonado (2h)
  POS_VENDA // Pós-venda D+7
  REATIVACAO // Cliente inativo 60 dias
  INGRESSO_CONFIRMADO // Ingresso de evento confirmado
  MANUAL // Enviada manualmente pelo admin
}

enum MensagemStatus {
  PENDENTE // Na fila, aguardando envio
  ENVIANDO // Em processo de envio
  ENVIADA // Evolution API confirmou envio
  ENTREGUE // WhatsApp confirmou entrega
  LIDA // Cliente leu a mensagem
  FALHA // Falhou após max tentativas
  CANCELADA // Cancelada manualmente
}

/// Outbox durável de e-mails transacionais. O pagamento cria a obrigação;
/// o worker faz a chamada externa com lease, idempotência e retentativas.
model EmailOutbox {
  id                 String            @id @default(cuid())
  chaveIdempotencia  String            @unique
  tipo               EmailOutboxTipo
  destinatario       String
  payload            Json
  status             EmailOutboxStatus @default(PENDENTE)
  tentativas         Int               @default(0)
  erro               String?           @db.Text
  proximaTentativaEm DateTime          @default(now())
  leaseExpiraEm      DateTime?
  providerId         String?
  enviadaEm          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status, proximaTentativaEm])
  @@index([status, leaseExpiraEm])
}

enum EmailOutboxTipo {
  PEDIDO_CONFIRMADO
  INGRESSO_CONFIRMADO
  NFE_AUTORIZADA
  PEDIDO_ENVIADO
  PEDIDO_ENTREGUE
}

enum EmailOutboxStatus {
  PENDENTE
  PROCESSANDO
  ENVIADO
  FALHA
}

model BlogPost {
  id        String   @id @default(cuid())
  titulo    String
  slug      String   @unique
  capaUrl   String?
  conteudo  String   @db.Text
  autor     String
  publicado Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// MÓDULO GLOSSÁRIO — fragmento de schema.prisma
// ============================================================
// Cole estes models no seu schema.prisma e rode:
//   npx prisma migrate dev --name add_glossario
// ============================================================

/// Termo do glossário (substituto do post type "glossario" do WordPress)
model GlossaryTerm {
  id           String         @id @default(cuid())
  /// Título do termo. Ex: "Pneu Radial"
  termo        String
  /// Slug URL-friendly. Ex: "pneu-radial"
  slug         String         @unique
  /// Letra inicial em maiúscula (A-Z, ou "0-9" para números). Indexada para filtrar A-Z rapidamente.
  letra        String
  /// Conteúdo HTML/Markdown da definição. Mínimo recomendado: 300 palavras para SEO.
  conteudo     String         @db.Text
  /// Resumo curto (até 160 chars) — usado em meta description e schema.org
  resumo       String?
  /// Título SEO customizado (até 60 chars). Se vazio, usa "{termo} — Forza Motos"
  seoTitle     String?
  /// Nicho/contexto usado para geração IA. Ex: "pneus e peças de moto"
  nicho        String?
  /// URL da imagem destacada (opcional)
  imagem       String?
  /// Nome do autor exibido no schema.org
  autor        String         @default("Equipe Forza")
  /// Categoria/nicho do termo. Ex: "Pneus", "Motor", "Freios"
  categoria    String?
  /// Lista de termos relacionados (slugs)
  relacionados Json           @default("[]")
  /// Origem do conteúdo: MANUAL, AI_GEMINI, AI_OPENAI
  origem       GlossaryOrigem @default(MANUAL)
  /// Status de publicação
  publicado    Boolean        @default(false)
  /// Marca true quando o conteúdo foi revisado por humano após geração por IA
  revisado     Boolean        @default(false)
  /// Visualizações (incrementadas em background)
  views        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([letra, publicado])
  @@index([categoria, publicado])
  @@index([createdAt])
}

enum GlossaryOrigem {
  MANUAL
  AI_GEMINI
  AI_OPENAI
  CSV_IMPORT
}

/// Fila de geração em massa de termos via IA
model GlossaryJob {
  id           String            @id @default(cuid())
  titulo       String
  letra        String
  nicho        String
  /// Provedor de IA a usar
  provider     GlossaryOrigem    @default(AI_GEMINI)
  /// Modelo específico. Ex: "gemini-2.0-flash" ou "gpt-4o-mini"
  modelo       String
  idioma       String            @default("pt-BR")
  estilo       String            @default("informativo e técnico")
  /// Tokens máximos (controla tamanho)
  maxTokens    Int               @default(2000)
  /// Prompt customizado adicional (concatenado ao prompt base)
  promptExtra  String?           @db.Text
  /// Status do job
  status       GlossaryJobStatus @default(PENDENTE)
  /// Quando processar (suporte a agendamento)
  agendadoPara DateTime?
  /// ID do termo criado após sucesso
  termoId      String?
  /// Mensagem de erro caso falhe
  erro         String?           @db.Text
  /// Quantas tentativas já foram feitas
  tentativas   Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status, agendadoPara])
}

enum GlossaryJobStatus {
  PENDENTE
  PROCESSANDO
  CONCLUIDO
  ERRO
}

// ============================================================
// MÓDULOS EXTRAS DE SEO — fragmento de schema.prisma
// ============================================================
// Adiciona suporte a Redirects e 404 Monitor (substituem os módulos
// "Redirections" e "404 Monitor" do Rank Math).
// ============================================================

/// Redirecionamentos gerenciáveis (via middleware ou route handler)
model SeoRedirect {
  id         String   @id @default(cuid())
  /// Path de origem. Ex: "/produto-antigo"
  from       String   @unique
  /// Path ou URL de destino
  to         String
  /// Código HTTP (301 permanente, 302 temporário, 307, 308)
  statusCode Int      @default(301)
  /// Quantas vezes esse redirect foi acessado
  hits       Int      @default(0)
  ativo      Boolean  @default(true)
  notas      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([from, ativo])
}

/// Log de 404 — útil para identificar links quebrados e oportunidades de redirect
model SeoNotFoundLog {
  id           String   @id @default(cuid())
  path         String
  /// User-agent agregado
  userAgent    String?  @db.Text
  /// Referer (de onde o usuário veio)
  referer      String?
  /// IP anonimizado (últimos octetos zerados)
  ip           String?
  /// Quantas vezes esse path foi acessado e deu 404
  hits         Int      @default(1)
  /// Marca true após criar um redirect para este path
  resolvido    Boolean  @default(false)
  /// Última vez acessado
  ultimoAcesso DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([path])
  @@index([resolvido, hits])
}

/// Log de toda notificação de indexação enviada para Google/Bing/etc.
/// Permite auditar o que foi enviado, debugar falhas e retry de URLs que falharam.
model SeoIndexingLog {
  id         String              @id @default(cuid())
  /// URL completa notificada
  url        String
  /// Ação enviada
  action     SeoIndexingAction   @default(URL_UPDATED)
  /// Provedor que recebeu a notificação
  provider   SeoIndexingProvider
  /// Status do envio
  status     SeoIndexingStatus   @default(PENDENTE)
  /// Mensagem de erro caso falhe
  erro       String?             @db.Text
  /// Quantidade de tentativas (incrementada a cada retry)
  tentativas Int                 @default(0)
  /// Resposta crua do provedor (útil para debug)
  resposta   String?             @db.Text
  /// Origem do trigger (manual, cron, hook automático)
  origem     String?
  /// Quando o envio foi efetivamente concluído (sucesso ou desistência)
  enviadoEm  DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([url, provider])
  @@index([status, createdAt])
  @@index([createdAt])
}

enum SeoIndexingAction {
  URL_UPDATED
  URL_DELETED
}

enum SeoIndexingProvider {
  GOOGLE
  INDEXNOW
}

enum SeoIndexingStatus {
  PENDENTE
  SUCESSO
  FALHA
  IGNORADO
}

// Configurações editáveis pelo painel admin (chave/valor).
// Usado para Google Site Verification, nome do site, URL, etc.
model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/// Cache de consultas de placa (API Placas/wdapi2 cobra por consulta —
/// mesma placa consultada de novo sai do cache, não da API)
model PlacaConsulta {
  placa     String   @id
  /// Resposta normalizada: { marca, modelo, ano, cor }
  resposta  Json
  createdAt DateTime @default(now())
}

// ============================================================
// MÓDULO CALENDÁRIO DE EVENTOS
// ============================================================

model Evento {
  id             String    @id @default(cuid())
  titulo         String
  slug           String    @unique
  descricao      String    @db.Text
  conteudo       String    @db.Text
  dataInicio     DateTime
  dataFim        DateTime?
  local          String
  endereco       String?
  imagemUrl      String?
  /// Galeria de fotos do evento — carrossel (roteiro, passeios anteriores, pontos visitados)
  galeria        Json      @default("[]")
  /// Opções de vaga p/ evento pago: [{label, preco}] — ex: Sozinho, Com garupa, Quarto p/ 4
  opcoesVaga     Json      @default("[]")
  /// 0 = gratuito
  preco          Decimal   @default(0) @db.Decimal(10, 2)
  categoria      String    @default("Evento")
  vagas          Int?
  linkExterno    String?
  ativo          Boolean   @default(true)
  publicado      Boolean   @default(false)
  /// Mantém o evento acessível por link direto, sem exibi-lo na home/calendário.
  ocultoListagem Boolean   @default(false)
  destaque       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  inscricoes EventoInscricao[]

  @@index([publicado, dataInicio])
  @@index([categoria, publicado])
}

model EventoInscricao {
  id                        String                @id @default(cuid())
  eventoId                  String
  evento                    Evento                @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  nome                      String
  email                     String
  telefone                  String
  quantidade                Int                   @default(1)
  /// Se o participante vai acompanhado de garupa
  temGarupa                 Boolean               @default(false)
  /// Nome completo da garupa (se temGarupa = true)
  nomeGarupa                String?
  /// Preferência de quarto/acomodação: "Quarto Casal", "Quarto Single / Compartilhado"
  tipoAcomodacao            String?
  /// Modelo da moto do participante (ex: BMW R1250 GS, Tiger 900)
  motoModelo                String?
  /// CPF do participante (obrigatório em eventos pagos para hotel/seguro)
  cpf                       String?
  /// CEP do participante
  cep                       String?
  /// Número residencial do participante
  numeroResidencia          String?
  /// Rótulo da opção de vaga escolhida (ex: "Com garupa") — snapshot no momento da compra
  opcaoVagaLabel            String?
  /// Preço unitário da opção escolhida — snapshot (preço do evento pode mudar depois)
  opcaoVagaPreco            Decimal?              @db.Decimal(10, 2)
  total                     Decimal               @db.Decimal(10, 2)
  status                    EventoInscricaoStatus @default(PENDENTE)
  /// ID da preferência no Mercado Pago
  mpPreferenciaId           String?
  /// ID do pagamento aprovado no Mercado Pago
  mpPagamentoId             String?               @unique
  /// Chave enviada pelo navegador para tornar retries do checkout idempotentes.
  checkoutTentativaId       String?               @unique
  /// Token opaco usado na página pública de acompanhamento da inscrição.
  consultaToken             String?               @unique
  /// Prazo durante o qual uma inscrição pendente ocupa uma vaga.
  reservaExpiraEm           DateTime?
  /// Último status observado no Mercado Pago.
  mpStatus                  String?
  /// Indica que a preferência pode ter sido criada, mas a resposta foi inconclusiva.
  pagamentoResultadoIncerto Boolean               @default(false)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  tentativasPagamento EventoPagamentoTentativa[]
  reembolsos          EventoReembolsoPagamento[]

  @@index([eventoId, status])
  @@index([email])
  @@index([status, reservaExpiraEm])
}

enum EventoInscricaoStatus {
  PENDENTE
  PAGO
  CANCELADO
}

/// Cada pagamento observado para uma inscrição. Uma preferência pode receber
/// várias tentativas; uma rejeição não pode invalidar uma aprovação posterior.
model EventoPagamentoTentativa {
  id          String          @id @default(cuid())
  inscricaoId String
  inscricao   EventoInscricao @relation(fields: [inscricaoId], references: [id], onDelete: Restrict)
  paymentId   String          @unique
  status      String
  metodo      String?
  valor       Decimal?        @db.Decimal(10, 2)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([inscricaoId, status])
}

/// Outbox durável para estornos de pagamentos de eventos.
model EventoReembolsoPagamento {
  id                 String          @id @default(cuid())
  inscricaoId        String
  inscricao          EventoInscricao @relation(fields: [inscricaoId], references: [id], onDelete: Restrict)
  paymentId          String          @unique
  motivo             String
  status             ReembolsoStatus @default(PENDENTE)
  tentativas         Int             @default(0)
  ultimoErro         String?
  proximaTentativaEm DateTime?
  concluidoEm        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([status, proximaTentativaEm])
  @@index([inscricaoId])
}

