  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  respostas EventoPirelliQuizResposta[]

  @@index([perguntaId, ordem])
}

model EventoPirelliQuizPergunta {
  id                   String                @id @default(cuid())
  eventoId             String
  evento               EventoPirelli         @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  enunciado            String                @db.Text
  explicacao           String?               @db.Text
  tipo                 EventoPirelliQuizTipo @default(MULTIPLA_ESCOLHA)
  respostaCorretaTexto String?               @db.Text
  ordem                Int                   @default(0)
  pontos               Int                   @default(1)
  ativa                Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  opcoes    EventoPirelliQuizOpcao[]
  respostas EventoPirelliQuizResposta[]

  @@index([eventoId, ativa, ordem])
}

model EventoPirelliQuizResposta {
  id                String                     @id @default(cuid())
  tentativaId       String
  tentativa         EventoPirelliQuizTentativa @relation(fields: [tentativaId], references: [id], onDelete: Cascade)
  perguntaId        String
  pergunta          EventoPirelliQuizPergunta  @relation(fields: [perguntaId], references: [id])
  opcaoId           String?
  opcao             EventoPirelliQuizOpcao?    @relation(fields: [opcaoId], references: [id])
  respostaTexto     String?                    @db.Text
  enunciadoSnapshot String                     @db.Text
  opcaoSnapshot     String
  corretaSnapshot   Boolean
  pontosGanhos      Int

  @@unique([tentativaId, perguntaId])
  @@index([perguntaId])
  @@index([opcaoId])
}

model EventoPirelliQuizTentativa {
  id              String                 @id @default(cuid())
  visitanteId     String                 @unique
  visitante       EventoPirelliVisitante @relation(fields: [visitanteId], references: [id], onDelete: Cascade)
  pontuacao       Int                    @default(0)
  pontuacaoMaxima Int                    @default(0)
  acertouTodas    Boolean                @default(false)
  /// O cronômetro oficial começa no servidor quando as perguntas são liberadas.
  iniciadaEm      DateTime               @default(now())
  concluidaEm     DateTime?
  /// Duração oficial do quiz, usada como primeiro critério de desempate.
  duracaoMs       Int?
  /// Ordem sorteada e persistida para que atualizar a página não gere outro quiz.
  ordemPerguntas  Json                   @default("[]")
  ordemOpcoes     Json                   @default("{}")

  respostas          EventoPirelliQuizResposta[]
  eventoComoVencedor EventoPirelli?              @relation("EventoPirelliVencedorQuiz")

  @@index([acertouTodas, duracaoMs, concluidaEm, id])
}

model EventoPirelliVisitante {
  id                         String        @id @default(cuid())
  eventoId                   String
  evento                     EventoPirelli @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  nomeCompleto               String
  /// Só é preenchido quando o visitante efetivamente compra ou ganha uma caneca.
  nomeGravacao               String?
  nomeGravacaoConfirmadoEm   DateTime?
  /// Auditoria da confirmação: operador do PDV, cliente pelo link ou sistema.
  nomeGravacaoConfirmadoPor  String?
  whatsapp                   String
  email                      String?
  instagram                  String?
  enderecoCep                String?
  enderecoRua                String?
  enderecoNumero             String?
  enderecoComplemento        String?
  enderecoBairro             String?
  enderecoCidade             String?
  enderecoEstado             String?
  motoMarca                  String?
  motoModelo                 String?
  motoAno                    Int?
  consentimentoMarketingEm   DateTime?
  /// Evita dupla criação quando a rede cai após o POST chegar ao servidor.
  chaveSubmissao             String        @unique
  /// Token opaco de acesso; nunca é um dado pessoal nem é exibido isoladamente.
  codigoQr                   String        @unique
  /// Referência solta, pois CrmLead não é alterado com uma relação reversa.
  crmLeadId                  String?
  /// Kit operacional entregue após o cadastro: um chaveiro e um adesivo.
  kitParticipacaoEntregueEm  DateTime?
  kitParticipacaoEntreguePor String?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  tentativaQuiz        EventoPirelliQuizTentativa?
  participacaoFoto     EventoPirelliParticipacaoFoto?
  balanceamento        EventoPirelliBalanceamento?
  elegibilidadesCaneca EventoPirelliElegibilidadeCaneca[]
  canecaBrinde         EventoPirelliCaneca?
  comprasCaneca        EventoPirelliCompraCaneca[]
  lancamentosCaixa     EventoPirelliLancamentoCaixa[]
  vendasPresenciais    EventoPirelliVendaPresencial[]
  pedidos              Order[]

  @@unique([eventoId, whatsapp])
  @@index([eventoId, createdAt])
}

model PagamentoTentativa {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  /// ID do pagamento no Mercado Pago — único, garante idempotência do webhook.
  paymentId String   @unique
  status    String
  metodo    String?
  valor     Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, status])
}

model ReembolsoPagamento {
  id                 String          @id @default(cuid())
  orderId            String
  order              Order           @relation(fields: [orderId], references: [id])
  paymentId          String          @unique
  motivo             String
  status             ReembolsoStatus @default(PENDENTE)
  tentativas         Int             @default(0)
  ultimoErro         String?
  proximaTentativaEm DateTime?
  concluidoEm        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([status, proximaTentativaEm])
}
