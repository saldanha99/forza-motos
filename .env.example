# Copie para .env.local e preencha os valores

# PostgreSQL próprio na VPS (container "db" na rede docker "forza").
# Conexão direta, sem pooler — não use mais Neon.
# Ex.: postgresql://forza_user:SENHA@db:5432/forzamotos?sslmode=disable
DATABASE_URL=postgresql://usuario:senha@db:5432/forzamotos?sslmode=disable

NEXTAUTH_SECRET=gere-com-openssl-rand-base64-32
NEXTAUTH_URL=https://seudominio.com.br
# Opcional: segredo dedicado ao hash dos códigos de recuperação Pirelli.
# Sem ele, o sistema usa NEXTAUTH_SECRET e continua falhando fechado se faltar ambos.
EVENTO_PIRELLI_RECUPERACAO_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MERCADOPAGO_ACCESS_TOKEN=
# ID da conta que deve receber os pagamentos. O webhook rejeita pagamentos de
# outro recebedor; portanto esta variável é obrigatória em produção.
MERCADOPAGO_COLLECTOR_ID=
# Assinatura secreta do webhook (MP → Suas integrações → Webhooks → Assinatura secreta)
# Obrigatória: sem ela o webhook rejeita todas as notificações (fail-closed).
MERCADOPAGO_WEBHOOK_SECRET=
# URL HTTPS canônica enviada em cada preferência de pagamento.
MERCADOPAGO_NOTIFICATION_URL=https://seudominio.com.br/api/mercadopago/webhook
# Use somente no ambiente isolado de testes para abrir sandbox_init_point.
MERCADOPAGO_SANDBOX=false

# Reserva temporária de estoque/vagas enquanto o cliente conclui o pagamento.
CHECKOUT_RESERVA_MINUTOS=60
# Desative em testes para não criar pedido Olist, etiqueta, e-mail ou WhatsApp reais.
POS_PAGAMENTO_INTEGRACOES_HABILITADAS=true

BLOB_READ_WRITE_TOKEN=

OLIST_CLIENT_ID=
OLIST_CLIENT_SECRET=
OLIST_TOKEN=
# Token opcional para proteger o webhook de entrada do Olist/Tiny.
# Se setado, cadastre a URL do webhook como .../api/olist/webhook?secret=<valor>
OLIST_WEBHOOK_SECRET=

CORREIOS_USUARIO=
CORREIOS_SENHA=

# ============================================================
# Melhor Envio — cotação de frete (PAC, SEDEX, Jadlog, JeT, etc)
# ============================================================
# 1. Cadastro gratuito: https://melhorenvio.com.br
# 2. Token: Menu → Configurações → Tokens → Gerar Token de API
# 3. Em PRODUÇÃO use https://www.melhorenvio.com.br/api/v2
#    Em DESENVOLVIMENTO use https://sandbox.melhorenvio.com.br/api/v2 (recomendado para testes)
MELHOR_ENVIO_TOKEN=
# Client Secret usado para validar X-ME-Signature dos webhooks.
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_URL=https://sandbox.melhorenvio.com.br/api/v2
MELHOR_ENVIO_CEP_ORIGEM=
# User-Agent deve incluir um email de contato — obrigatório pela documentação
MELHOR_ENVIO_USER_AGENT=Forza Motos contato@forzamotos.com.br
# Dados fiscais reais do remetente. Para envio comercial, o Melhor Envio exige
# CNPJ + Inscrição Estadual + chave da NF-e específica do pedido.
LOJA_CNPJ=
LOJA_INSCRICAO_ESTADUAL=
LOJA_NOME=Forza Motos
LOJA_EMAIL=
LOJA_TELEFONE=
LOJA_RUA=
LOJA_NUMERO=
LOJA_COMPLEMENTO=
LOJA_BAIRRO=
LOJA_CIDADE=Campinas
LOJA_UF=SP
# Obrigatória para envio comercial. Use a inscrição estadual real da loja.
# Sem ela, o preparo do carrinho/etiqueta falha de forma segura.
LOJA_INSCRICAO_ESTADUAL=

WHATSAPP_NUMBER=5519974049445
NEXT_PUBLIC_WHATSAPP=5519974049445

# ============================================================
# Evolution API (WhatsApp) + Assessoria de estoque
# ============================================================
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=forza-motos
# Segredo dedicado que o cron cadastra como header no webhook da Evolution.
# Obrigatório em produção (gere com `openssl rand -hex 32`).
EVOLUTION_WEBHOOK_SECRET=
# Destinos operacionais do resultado ao clicar em "Encerrar quiz e apurar".
# O grupo usa o JID estável obtido do convite; a instância precisa já ser membro.
EVENTO_PIRELLI_RESULTADO_WHATSAPP=5519992774625
EVENTO_PIRELLI_RESULTADO_GRUPO_JID=120363427125752663@g.us
# Proteções contra rajadas. O código ainda impõe teto máximo de 10/minuto.
WHATSAPP_MAX_POR_MINUTO=5
WHATSAPP_INTERVALO_MS=2500
WHATSAPP_JITTER_MS=1000
# JID do grupo de assessoria (alerta de conflito de estoque nos agendamentos).
# Formato de grupo: 120363XXXXXXXXXXXX@g.us — NÃO é telefone.
# Também pode ser definido no banco (Setting key=grupo_assessoria_jid).
GRUPO_ASSESSORIA_JID=
# IA conversacional da assessoria (Fase 3) — responde perguntas no grupo.
# Webhook Evolution (MESSAGES_UPSERT) → /api/assessoria/webhook.
# Use OpenRouter (grátis: openrouter.ai) OU OpenAI. Basta UMA das chaves.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Opcionais: sobrescrevem modelo e base URL.
# OpenRouter default: nvidia/nemotron-nano-9b-v2:free · OpenAI default: gpt-4o-mini
# Dica: se o modelo grátis ignorar as ferramentas, use "openai/gpt-4o-mini".
ASSESSORIA_AI_MODEL=
ASSESSORIA_AI_BASE_URL=

# ============================================================
# SEO Toolkit
# ============================================================

# Site base URL (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://forzamotos.com.br

# Google Site Verification for Search Console
GOOGLE_SITE_VERIFICATION=

# Cron (gere com: openssl rand -hex 32)
CRON_SECRET=

# IA — Glossário (escolha 1 ou os 2 providers)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Indexing API (opcional, requer Service Account)
# Cole o JSON completo do service account
GOOGLE_INDEXING_CREDENTIALS=

# IndexNow (Bing/Yandex) — gere com: openssl rand -hex 32
# Lembre de criar public/<INDEXNOW_KEY>.txt com o conteúdo igual à chave
INDEXNOW_KEY=
